# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# Set the same values in your host's dashboard (Vercel / Cloudflare Pages)
# for production — .env is gitignored and is not deployed.

# Access key from https://web3forms.com (free; the key is tied to your email).
# Without this the contact form cannot send anything.
VITE_WEB3FORMS_KEY=

# Comma-separated hosts allowed to submit the contact form. Subdomains of each
# entry are allowed too. localhost and 127.0.0.1 always work without listing.
# Example: VITE_ALLOWED_ORIGINS=sreebhargava.dev,my-portfolio.vercel.app
VITE_ALLOWED_ORIGINS=
